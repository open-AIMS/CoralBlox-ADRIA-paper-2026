	month = jun,
	year = {2018},
	keywords = {Juvenile corals, Thermal stress, Climate change, Ecology, Coral reefs},
	pages = {527--532},
	annote = {Relative bleaching sensitivity of juveniles and adults is taxon dependent, but juveniles are less affected by high DHWs
},
